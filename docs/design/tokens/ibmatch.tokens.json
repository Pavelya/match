  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Bricolage Grotesque",
        "Atkinson Hyperlegible Next",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    },
    "sans": {
      "$value": [
        "Atkinson Hyperlegible Next",
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": ["ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"]
    }
  },
  "typography": {
    "$type": "typography",
    "display-2xl": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "clamp(2.5rem, 1.85rem + 2.6vw, 4rem)",
        "fontWeight": 700,
        "lineHeight": 1.02,
        "letterSpacing": {
          "value": -0.025,
          "unit": "em"
        }
      },
      "$description": "Marketing hero H1 only. 40px on phones to 64px on desktop."
    },
    "display-xl": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "clamp(2rem, 1.6rem + 1.6vw, 3rem)",
        "fontWeight": 700,
        "lineHeight": 1.06,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      },
      "$description": "Marketing section headings (H2) and country-guide H1."
    },
    "display-lg": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "clamp(1.75rem, 1.55rem + 0.8vw, 2.25rem)",
