  "semantic": {
    "light": {
      "$type": "color",
      "bg": {
        "$value": "{primitive.color.ink-25}",
        "$description": "Page background."
      },
      "surface": {
        "$value": "{primitive.color.ink-0}",
        "$description": "Cards, header, inputs: the default raised surface on `bg`."
      },
      "surface-muted": {
        "$value": "{primitive.color.ink-50}",
        "$description": "Sunken areas: filter panels, quick-facts rows, table stripes."
      },
      "surface-strong": {
        "$value": "{primitive.color.ink-100}",
        "$description": "Hover fill for neutral controls, skeletons, chips at rest."
      },
      "surface-inverse": {
        "$value": "{primitive.color.ink-950}",
        "$description": "Footer and dark bands. Pair with `fg-on-inverse`."
      },
      "fg": {
        "$value": "{primitive.color.ink-900}",
        "$description": "Primary text and headings on `bg`, `surface`, `surface-muted`."
      },
      "fg-muted": {
        "$value": "{primitive.color.ink-600}",
        "$description": "Secondary text: university names, meta lines, hints. On `bg`, `surface`, `surface-muted`."
      },
      "fg-subtle": {
        "$value": "{primitive.color.ink-500}",
        "$description": "Placeholder and disabled text only; never for information that must be read."
      },
      "fg-on-inverse": {
        "$value": "{primitive.color.ink-50}",
        "$description": "Text on `surface-inverse`."
      },
      "border": {
        "$value": "{primitive.color.ink-200}",
        "$description": "Dividers and card outlines (decorative)."
      },
      "border-strong": {
        "$value": "{primitive.color.ink-500}",
        "$description": "Input and selectable-tile outlines: 3:1 against `surface`."
      },
      "primary": {
        "$value": "{primitive.color.blue-600}",
        "$description": "Primary buttons, links, selected states, focus ring. Text on `surface` and `bg`."
      },
      "primary-hover": {
        "$value": "{primitive.color.blue-700}",
        "$description": "Hover and pressed state of `primary` fills."
      },
      "on-primary": {
        "$value": "{primitive.color.ink-0}",
        "$description": "Text and icons on `primary` fills."
      },
      "primary-soft": {
        "$value": "{primitive.color.blue-50}",
        "$description": "Selected tiles, active nav pill, info callouts."
      },
      "primary-soft-fg": {
        "$value": "{primitive.color.blue-700}",
        "$description": "Text on `primary-soft`."
      },
      "brand-mark": {
        "$value": "{primitive.color.blue-logo}",
        "$description": "The logo tile and large brand graphics only (not text)."
      },
      "focus": {
        "$value": "{primitive.color.blue-600}",
        "$description": "Focus outline: 2px solid, 2px offset, on every interactive element."
      },
      "success": {
        "$value": "{primitive.color.green-700}",
        "$description": "Requirement met, strong match: text and icons on `surface`."
      },
      "success-soft": {
        "$value": "{primitive.color.green-50}",
        "$description": "Background of success callouts and met-requirement rows."
      },
      "warning": {
        "$value": "{primitive.color.amber-700}",
        "$description": "Partly met, deadlines, data that needs checking: text and icons."
      },
      "warning-soft": {
        "$value": "{primitive.color.amber-50}",
        "$description": "Background of warning callouts."
      },
      "danger": {
        "$value": "{primitive.color.red-700}",
        "$description": "Requirement not met, errors, destructive actions: text and icons."
      },
      "danger-soft": {
        "$value": "{primitive.color.red-50}",
        "$description": "Background of error callouts and unmet-requirement rows."
      },
      "highlight": {
        "$value": "{primitive.color.sun-300}",
        "$description": "Highlighter marker behind a key word in marketing headlines, and the 'Updated' badge. Always with `ink-900` text."
      },
      "on-highlight": {
        "$value": "{primitive.color.ink-900}",
        "$description": "Text on `highlight`."
      }
    },
