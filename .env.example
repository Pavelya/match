# ============================================================
# REQUIRED — the app will not start without these.
# Validated by Zod in lib/env.ts; a missing value throws at boot.
# ============================================================

# --- Database (PostgreSQL / Supabase) ---
# DATABASE_URL goes through the pooler; DIRECT_URL is used for migrations.
DATABASE_URL="postgres://user:password@host:port/database?sslmode=require&pgbouncer=true"
DIRECT_URL="postgres://user:password@host:port/database?sslmode=require"

# --- Authentication (NextAuth.js v5 / Auth.js) ---
# Must be at least 32 characters. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# Google Cloud Console -> APIs & Services -> Credentials.
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# --- Email (Resend) ---
# EMAIL_FROM must be a verified sender on your Resend domain.
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="noreply@yourdomain.com"

# --- Cache and rate limiting (Upstash Redis) ---
# Rate limiting depends on these, so they are required even in development.
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"


# ============================================================
# OPTIONAL — features degrade or switch off when unset.
# ============================================================

# --- Search (Algolia) ---
# Without these, search falls back to the database.
ALGOLIA_APP_ID="your-app-id"
ALGOLIA_ADMIN_API_KEY="your-admin-api-key"
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY="your-search-only-api-key"

# --- Payments (Stripe) ---
# Only needed for REGULAR school subscriptions; VIP schools never touch Stripe.
# STRIPE_PRODUCT_ID is read directly by app/api/subscriptions/create-checkout
# and is not part of the lib/env.ts schema.
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_PRODUCT_ID="prod_your_product_id"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# --- Supabase storage (university images) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Internal service-to-service calls ---
# Shared secret for internal API routes such as matches/precompute.
INTERNAL_API_KEY="generate-a-random-string"

# --- Public base URL, used in emails and canonical links ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ============================================================
# RUNTIME FLAGS
# ============================================================

# Matching algorithm v10. Read dynamically by lib/feature-flags.
MATCHING_V10_FULL=true

# Log matching performance metrics outside development.
# MATCHING_METRICS_LOG=true

# Auth.js trusts the request host automatically in development and on
# Vercel. Uncomment when running a PRODUCTION build anywhere else
# (npm start locally, a container, CI) or every /api/auth/* route
# returns 500 with UntrustedHost.
# AUTH_TRUST_HOST=true

NODE_ENV="development"
