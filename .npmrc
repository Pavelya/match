# A dependency's install script that `allowScripts` in package.json neither approves nor denies
# fails the install, instead of running with a warning (MAINT 6.7). Review the script, then run
# `npm install-scripts approve <pkg>` or `npm install-scripts deny <pkg>` in the same pull request.
# It also stops a one-off `npx <pkg>` run here whose package has an install script; add
# `--allow-scripts=<pkg>` to that one command.
strict-allow-scripts=true
